{
  "name": "wetwipe-qr",
  "version": "1.0.0",
  "private": true,
  "description": "Anonymous wet-wipe QR scan pilot on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && wrangler deploy --dry-run",
    "db:create": "wrangler d1 create wetwipe-pilot-db",
    "db:migrate:local": "wrangler d1 migrations apply wetwipe-pilot-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply wetwipe-pilot-db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.131.1"
  }
}
